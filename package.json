{
	"name": "@compdata/ui",
	"version": "0.1.5",
	"description": "Gemeinsame UI-Bausteine, App-Shell und Design-Tokens (Svelte 5, Tailwind 4)",
	"license": "UNLICENSED",
	"private": false,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/compdataitgmh/ui.git"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css",
		"./package.json": "./package.json",
		"./*.svelte": {
			"types": "./dist/*.svelte.d.ts",
			"svelte": "./dist/*.svelte",
			"default": "./dist/*.svelte"
		},
		"./*.js": {
			"types": "./dist/*.d.ts",
			"svelte": "./dist/*.js",
			"default": "./dist/*.js"
		},
		"./*": {
			"types": "./dist/*/index.d.ts",
			"svelte": "./dist/*/index.js",
			"default": "./dist/*/index.js"
		}
	},
	"peerDependencies": {
		"@lucide/svelte": "^0.561.0",
		"bits-ui": "^2.14.0",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.45.0",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0"
	},
	"peerDependenciesMeta": {
		"svelte-sonner": {
			"optional": true
		},
		"mode-watcher": {
			"optional": true
		}
	}
}
