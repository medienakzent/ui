{
	"name": "@compdata/ui",
	"version": "0.1.0",
	"description": "Gemeinsame UI-Bausteine, App-Shell und Design-Tokens (Svelte 5, Tailwind 4)",
	"license": "UNLICENSED",
	"private": false,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/compdataitgmh/ui.git"
	},
	"files": ["dist", "!dist/**/*.test.*", "!dist/**/*.spec.*"],
	"sideEffects": ["**/*.css"],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css",
		"./package.json": "./package.json",
		"./*": {
			"types": "./dist/*/index.d.ts",
			"svelte": "./dist/*/index.js",
			"default": "./dist/*/index.js"
		}
	},
	"scripts": {
		"prepare": "svelte-kit sync 2>/dev/null || true",
		"package": "svelte-package && publint || true",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"test:browser": "vitest --run --project browser",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"peerDependencies": {
		"@lucide/svelte": "^0.561.0",
		"bits-ui": "^2.14.0",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.45.0",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0"
	},
	"peerDependenciesMeta": {
		"svelte-sonner": { "optional": true },
		"mode-watcher": { "optional": true }
	},
	"devDependencies": {
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@vitest/browser-playwright": "^4.0.15",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.57.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vitest": "^4.0.15",
		"vitest-browser-svelte": "^2.0.1"
	}
}
